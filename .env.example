# --- LLM providers (at least one is required; Gemini has a free tier) ---
# https://aistudio.google.com -> Get API key
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional overrides of default model ids
# GOOGLE_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-5

# Optional providers (enable the switcher options)
# Free tier without a card: https://console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- MCP servers ---
# GitHub PAT with read-only scopes (repo metadata, issues, PRs)
GITHUB_TOKEN=
# Context7 works without a key (lower rate limits); key from https://context7.com/dashboard
CONTEXT7_API_KEY=
