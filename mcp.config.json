{
  "$schema": "./mcp.config.schema.json",
  "servers": [
    {
      "id": "fetch",
      "name": "Fetch",
      "description": "Завантажує вміст веб-сторінки за URL (markdown).",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "uvx",
        "args": [
          "mcp-server-fetch"
        ]
      }
    },
    {
      "id": "context7",
      "name": "Context7",
      "description": "Актуальна документація бібліотек (Next.js, React тощо).",
      "enabled": true,
      "transport": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
        }
      }
    },
    {
      "id": "sequential-thinking",
      "name": "Sequential Thinking",
      "description": "Покрокове розбиття складної задачі.",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-sequential-thinking"
        ]
      }
    },
    {
      "id": "github",
      "name": "GitHub",
      "description": "Пошук по репозиторіях, issues та PR (read-only PAT).",
      "enabled": true,
      "transport": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
          "Authorization": "Bearer ${GITHUB_TOKEN}"
        }
      },
      "allowedTools": [
        "search_repositories",
        "search_issues",
        "search_pull_requests",
        "search_code",
        "issue_read",
        "pull_request_read",
        "list_issues",
        "list_pull_requests",
        "get_file_contents",
        "list_commits",
        "get_commit",
        "get_latest_release"
      ]
    },
    {
      "id": "playwright",
      "name": "Playwright",
      "description": "Відкриває сторінки в браузері та збирає дані.",
      "enabled": false,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@playwright/mcp@latest",
          "--headless"
        ]
      },
      "allowedTools": [
        "browser_navigate",
        "browser_navigate_back",
        "browser_snapshot",
        "browser_find",
        "browser_click",
        "browser_type",
        "browser_press_key",
        "browser_select_option",
        "browser_wait_for",
        "browser_take_screenshot",
        "browser_close"
      ]
    },
    {
      "id": "filesystem",
      "name": "Filesystem (read-only)",
      "description": "Читання файлів у тестовій папці ./sandbox.",
      "enabled": true,
      "transport": {
        "type": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem",
          "./sandbox"
        ]
      },
      "allowedTools": [
        "read_text_file",
        "list_directory",
        "directory_tree",
        "search_files"
      ]
    }
  ]
}
